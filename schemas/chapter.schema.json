          "minLength": 1,
          "title": "Tr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bi"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "el",
        "tr",
        "en"
      ],
      "title": "Example",
      "type": "object"
    },
    "Examples": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "examples",
          "title": "Type",
          "type": "string"
