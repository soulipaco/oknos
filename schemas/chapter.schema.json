{
  "$defs": {
    "Bi": {
      "additionalProperties": false,
      "description": "Explanation text in both interface languages (both required).",
      "properties": {
        "tr": {
          "minLength": 1,
          "title": "Tr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "tr",
        "en"
      ],
      "title": "Bi",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "1-5 items (<pack>/<id>) answered inside the chapter. They do not count as exam evidence.",
      "properties": {
        "type": {
          "const": "check",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "Check",
      "type": "object"
    },
    "Dialogue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "dialogue",
          "title": "Type",
          "type": "string"
        },
        "setting": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bi"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/Line"
          },
          "minItems": 2,
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "type",
        "lines"
      ],
      "title": "Dialogue",
      "type": "object"
    },
    "Example": {
      "additionalProperties": false,
      "properties": {
        "el": {
          "minLength": 1,
          "title": "El",
          "type": "string"
