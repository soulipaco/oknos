        "items": {
          "items": {
            "$ref": "#/$defs/Example"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "Examples",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "who": {
          "minLength": 1,
          "title": "Who",
          "type": "string"
        },
        "el": {
          "minLength": 1,
          "title": "El",
          "type": "string"
        },
        "tr": {
          "minLength": 1,
          "title": "Tr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "who",
        "el",
        "tr",
        "en"
      ],
      "title": "Line",
      "type": "object"
    },
    "Prose": {
      "additionalProperties": false,
      "description": "A paragraph. Inline: **bold**, *italic*, [[Greek]] (tappable, read aloud).",
      "properties": {
        "type": {
          "const": "prose",
          "title": "Type",
          "type": "string"
        },
        "tr": {
          "minLength": 1,
          "title": "Tr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tr",
        "en"
      ],
      "title": "Prose",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "intro",
            "warmup",
            "text",
            "comprehension",
            "grammar",
            "words",
            "tips",
            "try"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bi"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "check": "#/$defs/Check",
                "dialogue": "#/$defs/Dialogue",
                "examples": "#/$defs/Examples",
                "prose": "#/$defs/Prose",
                "table": "#/$defs/Table",
                "tip": "#/$defs/Tip",
                "words": "#/$defs/Words"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Prose"
              },
              {
                "$ref": "#/$defs/Dialogue"
              },
              {
                "$ref": "#/$defs/Table"
              },
              {
                "$ref": "#/$defs/Examples"
              },
              {
                "$ref": "#/$defs/Words"
              },
              {
                "$ref": "#/$defs/Tip"
              },
              {
                "$ref": "#/$defs/Check"
              }
            ]
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "blocks"
      ],
      "title": "Section",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "description": "A grammar paradigm or a word table. A cell is Greek text (a string), or an explanation in\nboth languages ({tr, en}): the reader shows the one in the UI language.",
      "properties": {
        "type": {
          "const": "table",
          "title": "Type",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bi"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "head": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Bi"
              }
            ]
          },
          "minItems": 1,
          "title": "Head",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/Bi"
                }
              ]
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bi"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "head",
        "rows"
      ],
      "title": "Table",
      "type": "object"
    },
    "Tip": {
      "additionalProperties": false,
      "description": "tr_bridge: what Turkish shares; mistake: a typical error; exam: how it appears in the exam.",
      "properties": {
        "type": {
          "const": "tip",
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "tr_bridge",
            "mistake",
            "exam"
          ],
          "title": "Kind",
          "type": "string"
        },
        "tr": {
          "minLength": 1,
          "title": "Tr",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "exam_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exam Task"
        }
      },
      "required": [
        "type",
        "kind",
        "tr",
        "en"
      ],
      "title": "Tip",
      "type": "object"
    },
    "Words": {
      "additionalProperties": false,
      "description": "Vocab items, by key (<pack>/<id>). They belong to this chapter's stage.",
      "properties": {
        "type": {
          "const": "words",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "Words",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "curriculum": {
      "minLength": 1,
      "title": "Curriculum",
      "type": "string"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1"
      ],
      "title": "Level",
      "type": "string"
    },
    "title": {
      "$ref": "#/$defs/Bi"
    },
    "minutes": {
      "maximum": 30,
      "minimum": 3,
      "title": "Minutes",
      "type": "integer"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "id",
    "curriculum",
    "stage",
    "level",
    "title",
    "minutes",
    "sections"
  ],
  "title": "Chapter",
  "type": "object"
}
