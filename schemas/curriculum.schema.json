            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "lemmas": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lemmas",
          "type": "array"
        },
        "tenses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tenses",
          "type": "array"
        },
        "persons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Persons",
          "type": "array"
        },
        "grammar": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Grammar",
          "type": "array"
        },
        "pos": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Pos",
          "type": "array"
        },
        "types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        },
        "levels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Levels",
          "type": "array"
        },
        "topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "title": "Rule",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Words"
        },
        "theme": {
          "anyOf": [
            {
              "$ref": "#/$defs/Words"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "level": {
          "enum": [
            "A1",
            "A2",
            "B1"
          ],
          "title": "Level",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "review_of": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Review Of",
          "type": "array"
        },
        "include": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "title": "Include",
          "type": "array"
        },
        "can_do": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Words"
