      "title": "Stage",
      "type": "object"
    },
    "Words": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "title": "En",
          "type": "string"
        },
        "tr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tr"
        },
        "el": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "El"
        }
      },
      "required": [
        "en"
      ],
      "title": "Words",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "$ref": "#/$defs/Words"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "for_pack": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "For Pack"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    },
    "pools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Pool"
      },
      "title": "Pools",
      "type": "array"
    },
    "follows": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "default": {},
      "title": "Follows",
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "source",
    "stages"
  ],
  "title": "Curriculum",
  "type": "object"
