  "source": {
   "doc": "chapter",
   "stage": "lesson-07",
   "by": "sonnet-draft"
  }
 },
 {
  "id": "ch07-try-accusative",
  "type": "gap_bank",
  "skill": "grammar",
  "level": "A1",
  "topics": [
   "stage:lesson-07"
  ],
  "rubric": {
   "el": "Συμπληρώνω.",
   "en": "Fill in the gap.",
   "tr": "Boşluğu doldur."
  },
  "text": "Διαβάζω {1} εφημερίδα και περιμένω {2} Νίκο.",
  "bank": [
   "την",
   "τον",
   "το"
  ],
  "answer": {
   "1": "την",
   "2": "τον"
  },
  "translation": {
   "en": "I read the newspaper and wait for Nikos.",
   "tr": "Gazeteyi okuyorum ve Nikos'u bekliyorum."
  },
  "explain": {
   "en": "Both are objects. Feminine η εφημερίδα → την (vowel, so the -ν stays); masculine ο Νίκος → τον Νίκο.",
   "tr": "İkisi de nesne. Dişil η εφημερίδα → την (ünlü, -ν kalır); eril ο Νίκος → τον Νίκο."
  },
  "source": {
   "doc": "chapter",
   "stage": "lesson-07",
   "by": "sonnet-draft"
  }
 },
