 {
  "id": "ch07-try-enan",
  "type": "form",
  "skill": "grammar",
  "level": "A1",
  "topics": [
   "stage:lesson-07"
  ],
  "rubric": {
   "el": "Συμπληρώνω.",
   "en": "Fill in the gap.",
   "tr": "Boşluğu doldur."
  },
  "grammar": [
   "article.indefinite.accusative"
  ],
  "text": "Θέλω {1} καφέ.",
  "answer": {
   "1": [
    "έναν"
   ]
  },
  "options": {
   "1": [
    "ένας",
    "έναν",
    "ένα"
   ]
  },
  "translation": {
   "en": "I want a coffee.",
   "tr": "Bir kahve istiyorum."
  },
  "explain": {
   "en": "The coffee is the object of θέλω, and καφές is masculine: ένας → έναν (and καφές → καφέ).",
   "tr": "Kahve θέλω'nun nesnesi ve καφές eril: ένας → έναν (ve καφές → καφέ)."
