  "type": "match",
  "skill": "vocab",
  "level": "A1",
  "topics": [
   "stage:lesson-11"
  ],
  "rubric": {
   "el": "Αντιστοιχίζω.",
   "en": "Match each word with its plural.",
   "tr": "Her kelimeyi çoğuluyla eşleştir."
  },
  "left": [
   "η ντομάτα",
   "το μήλο",
   "ο πατέρας",
   "το κρεμμύδι"
  ],
  "right": [
   "τα μήλα",
   "οι πατέρες",
   "τα κρεμμύδια",
   "οι ντομάτες"
  ],
  "answer": [
   3,
   0,
   1,
   2
  ],
  "explain": {
   "en": "-α → -ες (ντομάτες), -ο → -α (μήλα), -ας → -ες (πατέρες), -ι → -ια (κρεμμύδια).",
   "tr": "-α → -ες (ντομάτες), -ο → -α (μήλα), -ας → -ες (πατέρες), -ι → -ια (κρεμμύδια)."
  },
  "source": {
   "doc": "chapter",
   "stage": "lesson-11",
   "by": "sonnet-draft"
  }
