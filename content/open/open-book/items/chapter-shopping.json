 {
  "id": "ch05-try-mila",
  "type": "form",
  "skill": "grammar",
  "level": "A1",
  "topics": [
   "stage:shopping"
  ],
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right form.",
   "tr": "Doğru biçimi seç."
  },
  "explain": {
