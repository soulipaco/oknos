 {
  "id": "ch05-try-fournos",
  "type": "form",
  "skill": "grammar",
  "level": "A1",
  "topics": [
   "stage:shopping"
  ],
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right form.",
   "tr": "Doğru biçimi seç."
  },
  "explain": {
   "en": "After τον the noun is the object: -ος becomes -ο → τον φούρνο.",
   "tr": "τον sözünden sonra isim nesne olur: -ος → -ο, yani τον φούρνο."
  },
  "source": {
   "doc": "chapter",
   "stage": "shopping",
   "by": "claude-sonnet"
  },
  "grammar": [
   "noun.accusative"
  ],
  "text": "Βλέπω τον {1}.",
  "answer": {
   "1": [
    "φούρνο"
   ]
  },
  "options": {
   "1": [
    "φούρνο",
    "φούρνος",
    "φούρνοι"
   ]
  },
  "translation": {
   "en": "I see the bakery.",
   "tr": "Fırını görüyorum."
  }
