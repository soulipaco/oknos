   "preposition.se-article"
  ],
  "text": "Η Σοφία έρχεται {1} μία.",
  "answer": {
   "1": [
    "στη"
   ]
  },
  "options": {
   "1": [
    "στη",
    "στις",
    "στο"
   ]
  },
  "translation": {
   "en": "Sofia comes at one.",
   "tr": "Sofia saat birde geliyor."
  }
 },
