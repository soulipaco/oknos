 {
  "id": "ch06-try-stis",
  "type": "form",
  "skill": "grammar",
  "level": "A1",
  "topics": [
   "stage:getting-around"
  ],
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right form.",
   "tr": "Doğru biçimi seç."
  },
  "explain": {
   "en": "ώρες is feminine plural, so σε + τις = στις: στις δύο.",
   "tr": "ώρες dişil çoğul; σε + τις = στις: στις δύο."
  },
  "source": {
   "doc": "chapter",
   "stage": "getting-around",
   "by": "claude-sonnet"
  },
  "grammar": [
   "preposition.se-article"
  ],
  "text": "Το μάθημα είναι {1} δύο.",
  "answer": {
   "1": [
    "στις"
   ]
  },
  "options": {
   "1": [
    "στις",
    "στη",
    "στο"
   ]
  },
  "translation": {
   "en": "The lesson is at two.",
   "tr": "Ders saat ikide."
  }
 },
 {
  "id": "ch06-try-stimia",
  "type": "form",
  "skill": "grammar",
  "level": "A1",
  "topics": [
   "stage:getting-around"
  ],
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right form.",
   "tr": "Doğru biçimi seç."
  },
  "explain": {
   "en": "One o'clock is singular (η ώρα): σε + την = στη before μία (the -ν drops before μ). στη μία.",
   "tr": "Saat bir tekil (η ώρα): σε + την = στη; μ'den önce -ν düşer. στη μία."
  },
  "source": {
   "doc": "chapter",
   "stage": "getting-around",
   "by": "claude-sonnet"
  },
