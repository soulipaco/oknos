 {
  "id": "ch06-q-paulos",
  "type": "mcq",
  "skill": "reading",
  "level": "A1",
  "topics": [
   "stage:getting-around"
  ],
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right answer.",
   "tr": "Doğru cevabı seç."
  },
  "explain": {
   "en": "Marko says «Ο κύριος Παύλος έρχεται στις εφτά και τέταρτο.» The lesson is at seven and it is now ten past seven.",
   "tr": "Marko «Ο κύριος Παύλος έρχεται στις εφτά και τέταρτο.» diyor. Ders saat yedide, şimdi de yedi on."
  },
  "source": {
   "doc": "chapter",
   "stage": "getting-around",
   "by": "claude-sonnet"
  },
  "prompt": {
   "el": "Τι ώρα έρχεται ο κύριος Παύλος;",
   "en": "What time does Mr Pavlos come?",
   "tr": "Pavlos Bey saat kaçta geliyor?"
  },
  "options": [
   "Στις εφτά.",
   "Στις εφτά και δέκα.",
   "Στις εφτά και τέταρτο."
  ],
  "answer": 2
 },
 {
  "id": "ch06-q-tf",
  "type": "true_false",
  "skill": "reading",
  "level": "A1",
  "topics": [
   "stage:getting-around"
  ],
  "rubric": {
   "el": "Σωστό ή λάθος;",
   "en": "True or false?",
   "tr": "Doğru mu, yanlış mı?"
  },
  "explain": {
   "en": "The woman says «Το είκοσι πέντε». The man says the pharmacy is five minutes on foot, not ten. Zeynep gets her ticket at the kiosk («Στο περίπτερο, εκεί»).",
   "tr": "Kadın «Το είκοσι πέντε» diyor. Adam eczanenin yürüyerek beş dakika olduğunu söylüyor, on değil. Zeynep biletini büfeden alıyor («Στο περίπτερο, εκεί»)."
  },
  "source": {
   "doc": "chapter",
   "stage": "getting-around",
   "by": "claude-sonnet"
  },
  "statements": [
   {
    "el": "Το είκοσι πέντε πάει στον Λευκό Πύργο.",
    "en": "Bus 25 goes to the White Tower.",
    "tr": "Yirmi beş numara Beyaz Kule'ye gidiyor.",
    "answer": true
   },
   {
    "el": "Το φαρμακείο είναι δέκα λεπτά με τα πόδια.",
    "en": "The pharmacy is ten minutes on foot.",
    "tr": "Eczane yürüyerek on dakika.",
    "answer": false
   },
   {
    "el": "Η Ζεϊνέπ παίρνει εισιτήριο στο περίπτερο.",
    "en": "Zeynep gets a ticket at the kiosk.",
    "tr": "Zeynep bileti büfeden alıyor.",
    "answer": true
   }
  ]
 },
