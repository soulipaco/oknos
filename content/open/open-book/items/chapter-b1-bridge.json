  "type": "form",
  "skill": "grammar",
  "level": "B1",
  "topics": [
   "stage:b1-bridge"
  ],
  "grammar": [
   "verb.passive.aorist"
  ],
  "cue": {
   "lemma": "αγοράζομαι",
   "person": "3sg",
   "tense": "aorist"
  },
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right form.",
   "tr": "Doğru biçimi seç."
  },
  "text": "Το εισιτήριο {1} χθες.",
  "answer": {
   "1": [
    "αγοράστηκε"
   ]
  },
  "options": {
   "1": [
    "αγοράστηκε",
    "αγοράζεται",
    "αγόρασε"
   ]
  },
  "translation": {
   "en": "The ticket was bought yesterday.",
   "tr": "Bilet dün alındı."
  },
  "explain": {
   "en": "The ticket does not buy; it is bought. χθες (yesterday) is a finished event: passive aorist, one word: αγοράστηκε. αγοράζεται is the present.",
   "tr": "Bilet satın almaz, satın alınır. χθες bitmiş bir olay: edilgen geçmiş zaman, tek kelime: αγοράστηκε. αγοράζεται şimdiki zaman."
  },
  "source": {
   "doc": "chapter",
   "stage": "b1-bridge",
   "by": "claude-sonnet"
  }
