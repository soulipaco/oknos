  "type": "true_false",
  "skill": "reading",
  "level": "B1",
  "topics": [
   "stage:b1-bridge"
  ],
  "rubric": {
   "el": "Σωστό ή λάθος;",
   "en": "True or false?",
   "tr": "Doğru mu, yanlış mı?"
  },
  "statements": [
   {
    "el": "Η προθεσμία για το έντυπο είναι η Παρασκευή.",
    "en": "The deadline for the form is Friday.",
    "tr": "Formun son tarihi cuma.",
    "answer": true
   },
   {
    "el": "Το πιστοποιητικό θα είναι έτοιμο την Παρασκευή.",
