  "grammar": [
   "verb.future",
   "verb.perfective_stem"
  ],
  "cue": {
   "lemma": "αγοράζω",
   "person": "1sg",
   "tense": "future"
  },
  "rubric": {
   "el": "Διαλέγω το σωστό.",
   "en": "Choose the right form.",
   "tr": "Doğru biçimi seç."
  },
  "text": "Αύριο εγώ θα {1} ψωμί στον φούρνο.",
  "answer": {
   "1": [
    "αγοράσω"
   ]
  },
  "options": {
   "1": [
    "αγοράσω",
    "αγοράσεις",
    "αγοράσουν"
   ]
  },
