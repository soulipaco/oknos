    "rubric": {
      "el": "Διαλέγω το σωστό.",
      "en": "Choose the right form.",
      "tr": "Doğru biçimi seç."
    },
    "grammar": [
      "pronoun.possessive",
      "stress"
    ],
    "text": "Το {1} μας είναι εκεί.",
    "answer": {
      "1": [
        "τηλέφωνό"
      ]
    },
    "options": {
      "1": [
        "τηλέφωνό",
        "τηλέφωνο",
        "τηλεφώνο"
      ]
    },
    "translation": {
      "en": "Our phone is there.",
      "tr": "Telefonumuz orada."
    },
    "explain": {
      "en": "τηλέφωνο is stressed on the third syllable from the end (τη-ΛΕ-φω-νο). Before μας it gets a second accent on the last syllable: το τηλέφωνό μας.",
      "tr": "τηλέφωνο sondan üçüncü hecede vurgulu (τη-ΛΕ-φω-νο). μας önünde sonuna ikinci bir vurgu alır: το τηλέφωνό μας."
